apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  namespace: overcommit-lab
  name: POOL
  labels:
    workload: POOL
spec:
  replicas: 1
  sandboxClasses:
  - name: microvm
    configRef:
      name: microvm
  workerImage: ghcr.io/agent-substrate/substrate/ateworker-microvm:v1.0.1@sha256:c424bf0ca945bf0b4328d40b2709030f56195e90d7a7599a92b74423769111ab
  template:
    resources:
      limits:
        cpu: "2"
        memory: 2560Mi
      requests:
        cpu: 250m
        memory: 2560Mi
